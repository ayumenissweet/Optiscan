{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.opticdb.app",
  "productName": "OptiScan",
  "directories": {
    "output": "releases"
  },
  "files": [
    "electron/dist/**/*",
    "backend/dist/**/*",
    "frontend/dist/**/*",
    "frontend/preload.js",
    "node_modules/**/*"
  ],
  "asar": true,
  "asarUnpack": [
    "**/*.node"
  ],
  "win": {
    "target": [
      "nsis"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "dependencies": {
    "optiscan": "file:.."
  }
}
