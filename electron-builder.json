{
  "appId": "com.opticdb.app",
  "productName": "OptiScan",
  "directories": { "output": "releases" },
  "files": [
    "package.json",
    "electron/dist/**/*",
    "backend/dist/**/*",
    "frontend/dist/**/*",
    "node_modules/**/*"
  ],
  "asar": true,
  "asarUnpack": ["**/*.node"],
  "npmRebuild": false,
  "win": {
    "target": [{ "target": "nsis", "arch": ["ia32"] }]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}